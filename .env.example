# Copy to .env and fill in. The CLI reads the process environment only (it does not load .env itself):
#   set -a; source .env; set +a; docs-watchdog
# Never commit .env. Everything here is OPTIONAL: with LLM_PROVIDER unset the tool runs in
# deterministic mode (no AI, no key) and still produces complete reports.

# anthropic | openai (any OpenAI-compatible endpoint) | demo
LLM_PROVIDER=
LLM_API_KEY=
# Optional: defaults to claude-sonnet-5-5 (anthropic) or gpt-4o-mini (openai)
LLM_MODEL=
# Optional: Azure OpenAI, OpenRouter, Ollama, vLLM, internal gateway, ...
LLM_BASE_URL=
